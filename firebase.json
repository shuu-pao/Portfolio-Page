{
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.**",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
      },
      {
        "source": "**/*.webp",
        "headers": [{"key": "Content-Type", "value": "image/webp"}]
      },
      {
        "source": "**/*.png",
        "headers": [{"key": "Content-Type", "value": "image/png"}]
      },
      {
        "source": "**/*.jpg",
        "headers": [{"key": "Content-Type", "value": "image/jpeg"}]
      }
    ]
  }
}